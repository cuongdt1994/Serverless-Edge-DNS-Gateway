{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "serverless-edge-dns-gateway",
  "main": "src/worker.js",
  "compatibility_date": "2026-10-11",
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/dns-query", "/debug", "/apple"]
  }
}
